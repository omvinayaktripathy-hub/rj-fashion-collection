{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.sqlite*",
      "**/*.db*",
      "**/*.env*",
      "**/*.log",
      "**/*.pem",
      "**/*.key",
      "**/*.crt",
      "**/serviceAccountKey*.json",
      "**/database/**",
      "**/scripts/**",
      "**/tests/**",
      "**/backups/**",
      "**/uploads/**",
      "**/temp/**",
      "**/*secret*",
      "**/*qr*.png",
      "**/*authenticator*.png"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/products",
        "destination": "/data/products.json"
      },
      {
        "source": "/api/categories",
        "destination": "/data/categories.json"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/-home",
        "destination": "/index.html"
      },
      {
        "source": "/delivery",
        "destination": "/delivery.html"
      },
      {
        "source": "/checkout",
        "destination": "/checkout.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/shop",
        "destination": "/shop.html"
      },
      {
        "source": "/cart",
        "destination": "/cart.html"
      },
      {
        "source": "/wishlist",
        "destination": "/wishlist.html"
      },
      {
        "source": "/account",
        "destination": "/account.html"
      },
      {
        "source": "/orders",
        "destination": "/orders.html"
      },
      {
        "source": "/categories",
        "destination": "/categories.html"
      },
      {
        "source": "/faq",
        "destination": "/faq.html"
      },
      {
        "source": "/sale",
        "destination": "/sale.html"
      },
      {
        "source": "/size-guide",
        "destination": "/size-guide.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://www.google-analytics.com https://checkout.razorpay.com https://js.stripe.com https://*.firebaseio.com https://*.googleapis.com https://www.gstatic.com https://apis.google.com https://*.firebaseapp.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.cloudfunctions.net https://accounts.google.com https://api.stripe.com https://api.razorpay.com https://images.unsplash.com https://*.google-analytics.com https://analytics.google.com https://wa.me https://*.firebaseapp.com https://*.web.app; frame-src 'self' https://accounts.google.com https://*.google.com https://checkout.razorpay.com https://js.stripe.com https://*.firebaseapp.com https://*.web.app; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\")"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "X-WAF-Protection",
            "value": "RJ-WAF/2.0-Active"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|svg|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(login|admin|checkout|delivery|cart|shop|account|orders|categories|faq|sale|size-guide|product|home|-home)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/.git{,/**}",
        "destination": "/404",
        "type": 302
      },
      {
        "source": "/.env{,/**}",
        "destination": "/404",
        "type": 302
      },
      {
        "source": "/images/google-authenticator-qr.png",
        "destination": "/404",
        "type": 302
      },
      {
        "source": "/uploads{,/**}",
        "destination": "/404",
        "type": 302
      },
      {
        "source": "/auth-blade{,.html}",
        "destination": "/404",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}