# RJ Fashion Collection - AI Virtual Try-On Service Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=5000

# Try-On Inference Mode:
# "gradio_free"   -> Free ZeroGPU inference via Hugging Face Space (Default: yisol/IDM-VTON)
# "local_torch"   -> Local PyTorch IDM-VTON / CatVTON (requires 12GB+ NVIDIA VRAM)
# "hybrid_offline"-> Local high-fidelity edge-preserving blending engine for offline dev & zero-queue testing
TRYON_MODE=gradio_free

# Hugging Face Space for Free Inference
HF_SPACE_NAME=yisol/IDM-VTON
# Optional HF User Access Token (Free personal token from huggingface.co/settings/tokens to bypass public queue limits)
HF_TOKEN=

# Safety & Processing Limits
MAX_IMAGE_SIZE_MB=10
ALLOWED_FORMATS=jpg,jpeg,png,webp
TIMEOUT_SECONDS=120

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
