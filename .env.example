# Server Environment
PORT=3000
NODE_ENV=production
SESSION_SECRET=your_super_secret_session_key_replace_in_production

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_ENABLED=true

# Nodemailer / Email Service (Optional for order confirmation emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=RJ Fashion Collection <orders@rjfashion.com>
EMAIL_ENABLED=false
